<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.VKZ" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/vk_blue</item>
        <item name="colorPrimaryVariant">@color/vk_blue_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/vk_blue_light</item>
        <item name="colorSecondaryVariant">@color/vk_blue</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Bottom navigation -->
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView.Colored</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.VKZ.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
    </style>
</resources>