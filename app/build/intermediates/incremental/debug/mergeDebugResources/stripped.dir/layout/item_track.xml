<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="?attr/selectableItemBackground">

        <!-- Playing indicator -->
        <View
            android:id="@+id/view_playing_indicator"
            android:layout_width="3dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_playing_indicator"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <!-- Cover -->
        <ImageView
            android:id="@+id/iv_track_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@string/cover_art" />

        <!-- Track info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/unknown_track" />

            <TextView
                android:id="@+id/tv_track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="@string/unknown_artist" />

        </LinearLayout>

        <!-- Duration -->
        <TextView
            android:id="@+id/tv_track_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:text="0:00" />

        <!-- Favorite button -->
        <ImageButton
            android:id="@+id/btn_track_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_favorite_outline"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_hint"
            android:contentDescription="@string/favorite" />

        <!-- Menu button -->
        <ImageButton
            android:id="@+id/btn_track_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_hint"
            android:contentDescription="@string/more_options" />

    </LinearLayout>

</androidx.cardview.widget.CardView>