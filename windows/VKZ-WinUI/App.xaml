<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VKZ.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKZ">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Акриловые кисти -->
            <AcrylicBrush
                x:Key="CustomAcrylicInAppBrush"
                FallbackColor="#1A1B1E"
                Opacity="0.9"
                TintColor="#1A1B1E"
                TintOpacity="0.1" />

            <AcrylicBrush
                x:Key="CustomAlternativeAcrylicInAppBrush"
                FallbackColor="#1A1B1E"
                TintColor="#1A1B1E"
                TintOpacity="0.001" />

            <!-- Шрифты VK Sans Display -->
            <FontFamily x:Key="VKSansDemiBold">/Assets/Fonts/VKSansDisplay-DemiBold.ttf#VK Sans Display DemiBold</FontFamily>
            <FontFamily x:Key="VKSansMedium">/Assets/Fonts/VKSansDisplay-Medium.ttf#VK Sans Display Medium</FontFamily>
            <FontFamily x:Key="VKSansBold">/Assets/Fonts/VKSansDisplay-Bold.ttf#VK Sans Display Bold</FontFamily>
            <FontFamily x:Key="VKSansRegular">/Assets/Fonts/VKSansDisplay-Regular.ttf#VK Sans Display Regular</FontFamily>

            <!-- Цвета темы -->
            <SolidColorBrush x:Key="AccentColorBrush" Color="#0077FF" />
            <SolidColorBrush x:Key="AccentColorBrush2" Color="#0077FF" />
            <SolidColorBrush x:Key="BackgroundColor" Color="#1A1B1E" />
            <SolidColorBrush x:Key="SurfaceColor" Color="#23242A" />
            <SolidColorBrush x:Key="SurfaceVariantColor" Color="#2C2D33" />
            <SolidColorBrush x:Key="TextPrimaryColor" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryColor" Color="#8A8B91" />
            <SolidColorBrush x:Key="DividerColor" Color="#3A3B41" />

            <!-- Стили для текста -->
            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource VKSansBold}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}" />
            </Style>

            <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource VKSansDemiBold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource VKSansRegular}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource VKSansMedium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}" />
            </Style>

            <!-- Стили для кнопок -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentColorBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="{StaticResource VKSansDemiBold}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,0" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceVariantColor}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}" />
                <Setter Property="FontFamily" Value="{StaticResource VKSansMedium}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,0" />
            </Style>

            <!-- Стили для TextBox -->
            <Style x:Key="AuthTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}" />
                <Setter Property="FontFamily" Value="{StaticResource VKSansRegular}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource TextSecondaryColor}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Стили для PasswordBox -->
            <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}" />
                <Setter Property="FontFamily" Value="{StaticResource VKSansRegular}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource TextSecondaryColor}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- ScrollViewer по умолчанию -->
            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>