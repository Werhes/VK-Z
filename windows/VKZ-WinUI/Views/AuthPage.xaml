<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKZ.Views.AuthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKZ.Views"
    xmlns:converters="using:VKZ.Converters"
    Background="{StaticResource BackgroundColor}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="400"
                Padding="32">

                <!-- Логотип и заголовок -->
                <Image
                    Source="/Assets/icon.png"
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8" />

                <TextBlock
                    Text="VK Z"
                    Style="{StaticResource TitleTextStyle}"
                    HorizontalAlignment="Center"
                    FontSize="32" />

                <TextBlock
                    Text="Слушайте музыку ВКонтакте"
                    Style="{StaticResource CaptionTextStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24" />

                <!-- Кнопка VK ID (экосистемная авторизация) -->
                <Button
                    x:Name="VkIdButton"
                    Content="Продолжить с VK ID"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    FontSize="16"
                    Click="OnVkIdClick">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0066DD" />
                    </Button.Resources>
                </Button>

                <TextBlock
                    Text="или"
                    Style="{StaticResource CaptionTextStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8" />

                <!-- Переключатель способа входа -->
                <ComboBox
                    x:Name="AuthMethodSelector"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource SurfaceColor}"
                    Foreground="{StaticResource TextPrimaryColor}"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Войти по токену" />
                    <ComboBoxItem Content="Войти по логину и паролю" />
                </ComboBox>

                <!-- Панель входа по токену -->
                <StackPanel
                    x:Name="TokenPanel"
                    Spacing="12"
                    Visibility="Visible">
                    <TextBox
                        x:Name="TokenTextBox"
                        PlaceholderText="Введите токен VK"
                        Style="{StaticResource AuthTextBoxStyle}"
                        TextWrapping="NoWrap" />
                    <TextBox
                        x:Name="UserIdTextBox"
                        PlaceholderText="ID пользователя (необязательно)"
                        Style="{StaticResource AuthTextBoxStyle}"
                        InputScope="Number" />
                    <Button
                        Content="Войти"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="OnTokenLoginClick" />
                </StackPanel>

                <!-- Панель входа по логину и паролю -->
                <StackPanel
                    x:Name="LoginPanel"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="LoginTextBox"
                        PlaceholderText="Телефон или email"
                        Style="{StaticResource AuthTextBoxStyle}" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        PlaceholderText="Пароль"
                        Style="{StaticResource AuthPasswordBoxStyle}" />
                    <Button
                        Content="Войти"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="OnPasswordLoginClick" />
                </StackPanel>

                <!-- Индикатор загрузки -->
                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Width="40"
                    Height="40"
                    Foreground="{StaticResource AccentColorBrush}" />

                <!-- Сообщение об ошибке -->
                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    Title="Ошибка авторизации"
                    IsOpen="False"
                    IsClosable="True" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>