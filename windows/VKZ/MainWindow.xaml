<Window x:Class="VKZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VKZ.Converters"
        Title="VK Z"
        Height="720"
        Width="1080"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1A1B1E"
        Foreground="White">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:SecondsToTimeConverter x:Key="SecondsToTime" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />

        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A8E99" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2E33" />
                                <Setter Property="Foreground" Value="#0077FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2E33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#232529" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="VK Z" FontSize="18" FontWeight="Bold" Foreground="#0077FF" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Name="NavPlaylists" Content="Плейлисты" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="OnNavChanged" />
                    <RadioButton Name="NavSearch" Content="Поиск" Style="{StaticResource NavTabStyle}" Checked="OnNavChanged" />
                    <RadioButton Name="NavMix" Content="VK Микс" Style="{StaticResource NavTabStyle}" Checked="OnNavChanged" />
                    <RadioButton Name="NavPopular" Content="Популярное" Style="{StaticResource NavTabStyle}" Checked="OnNavChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="UserInfoText" Text="Не авторизован" Foreground="#8A8E99" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Name="AuthButton" Content="Войти" Background="#0077FF" Foreground="White" Padding="12,4" FontSize="12" Click="AuthButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <views:AuthView xmlns:views="clr-namespace:VKZ.Views" x:Name="AuthViewControl" Visibility="Collapsed" />
            <views:PlaylistsView xmlns:views="clr-namespace:VKZ.Views" x:Name="PlaylistsViewControl" Visibility="Visible" />
            <views:SearchView xmlns:views="clr-namespace:VKZ.Views" x:Name="SearchViewControl" Visibility="Collapsed" />
            <views:MixView xmlns:views="clr-namespace:VKZ.Views" x:Name="MixViewControl" Visibility="Collapsed" />
            <views:PopularView xmlns:views="clr-namespace:VKZ.Views" x:Name="PopularViewControl" Visibility="Collapsed" />
        </Grid>

        <!-- Mini Player Bar -->
        <Border Grid.Row="2" Background="#232529" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#2C2E33" Margin="0,0,8,0">
                        <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="NowPlayingTitle" Text="Название трека" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Name="NowPlayingArtist" Text="Исполнитель" FontSize="11" Foreground="#8A8E99" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Name="PrevButton" Content="⏮" FontSize="16" Background="Transparent" Padding="8,4" Click="PrevButton_Click" />
                    <Button Name="PlayPauseButton" Content="▶" FontSize="20" Background="#0077FF" Width="36" Height="36" Padding="0" Margin="4,0" Click="PlayPauseButton_Click" />
                    <Button Name="NextButton" Content="⏭" FontSize="16" Background="Transparent" Padding="8,4" Click="NextButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="CurrentTimeText" Text="0:00" FontSize="11" Foreground="#8A8E99" VerticalAlignment="Center" />
                    <Slider Name="ProgressSlider" Width="120" Minimum="0" Maximum="100" Value="0" Margin="4,0" VerticalAlignment="Center" ValueChanged="ProgressSlider_ValueChanged" />
                    <TextBlock Name="DurationText" Text="0:00" FontSize="11" Foreground="#8A8E99" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Name="VolumeButton" Content="🔊" FontSize="14" Background="Transparent" Padding="4" Click="VolumeButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>