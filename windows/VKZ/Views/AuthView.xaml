<UserControl x:Class="VKZ.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1B1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Width="420">
            <TextBlock Text="Авторизация ВКонтакте"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <!-- Tab selection -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <RadioButton Name="TokenTab" Content="По токену" IsChecked="True"
                             Foreground="#8A8E99"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,8"
                             Checked="OnTabChanged"
                             FontSize="14" />
                <RadioButton Name="PhoneTab" Content="По телефону"
                             Foreground="#8A8E99"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="16,8"
                             Checked="OnTabChanged"
                             FontSize="14" />
            </StackPanel>

            <!-- Token Auth Panel -->
            <StackPanel Name="TokenPanel" Visibility="Visible">
                <TextBlock Text="Введите токен доступа"
                           FontSize="13"
                           Foreground="#8A8E99"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <Border Background="#232529" Padding="4">
                    <TextBox Name="TokenTextBox"
                             Text=""
                             FontSize="14"
                             Padding="12,8"
                             Background="Transparent"
                             Foreground="White" />
                </Border>
            </StackPanel>

            <!-- Phone Auth Panel -->
            <StackPanel Name="PhonePanel" Visibility="Collapsed">
                <TextBlock Text="Номер телефона"
                           FontSize="13"
                           Foreground="#8A8E99"
                           Margin="0,0,0,4" />
                <Border Background="#232529" Padding="4" Margin="0,0,0,12">
                    <TextBox Name="PhoneTextBox"
                             Text=""
                             FontSize="14"
                             Padding="12,8"
                             Background="Transparent"
                             Foreground="White" />
                </Border>

                <TextBlock Text="Пароль"
                           FontSize="13"
                           Foreground="#8A8E99"
                           Margin="0,0,0,4" />
                <Border Background="#232529" Padding="4" Margin="0,0,0,12">
                    <PasswordBox Name="PasswordBox"
                                 FontSize="14"
                                 Padding="12,8"
                                 Background="Transparent"
                                 Foreground="White" />
                </Border>

                <!-- 2FA Code Panel (hidden by default) -->
                <StackPanel Name="TwoFactorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Код двухфакторной авторизации"
                               FontSize="13"
                               Foreground="#8A8E99"
                               Margin="0,0,0,4" />
                    <Border Background="#232529" Padding="4">
                        <TextBox Name="TwoFactorTextBox"
                                 Text=""
                                 FontSize="14"
                                 Padding="12,8"
                                 Background="Transparent"
                                 Foreground="White" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button Name="AuthActionButton"
                    Content="Войти"
                    Background="#0077FF"
                    Foreground="White"
                    Padding="16,10"
                    FontSize="14"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Width="200"
                    Click="OnAuthClick" />

            <TextBlock Name="StatusText"
                       Text=""
                       FontSize="12"
                       Foreground="#FF3347"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>