<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- VK Colors -->
    <Color x:Key="VKBlue">#0077FF</Color>
    <Color x:Key="VKBlueDark">#005BB5</Color>
    <Color x:Key="VKBlueLight">#3399FF</Color>
    <Color x:Key="BackgroundDark">#1A1B1E</Color>
    <Color x:Key="BackgroundMedium">#232529</Color>
    <Color x:Key="BackgroundLight">#2C2E33</Color>
    <Color x:Key="SurfaceColor">#2C2E33</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#8A8E99</Color>
    <Color x:Key="TextTertiary">#5C5F66</Color>
    <Color x:Key="AccentColor">#0077FF</Color>
    <Color x:Key="AccentHover">#005BB5</Color>
    <Color x:Key="DividerColor">#3A3C42</Color>
    <Color x:Key="ErrorColor">#FF3347</Color>
    <Color x:Key="SuccessColor">#4BB34B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="VKBlueBrush" Color="{StaticResource VKBlue}" />
    <SolidColorBrush x:Key="VKBlueDarkBrush" Color="{StaticResource VKBlueDark}" />
    <SolidColorBrush x:Key="VKBlueLightBrush" Color="{StaticResource VKBlueLight}" />
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}" />
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}" />
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

</ResourceDictionary>